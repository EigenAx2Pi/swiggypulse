# SwiggyPulse Configuration

# Mock mode (default: true). Set to false to hit the live Swiggy MCP servers.
# Live mode uses OAuth 2.1 + PKCE with Dynamic Client Registration — no client
# secret and no Builders Club agreement needed to build on localhost.
USE_MOCK=true

# Swiggy MCP servers (streamable HTTP). No SWIGGY_CLIENT_ID/SECRET needed:
# the client self-registers via Dynamic Client Registration (/auth/register) and
# authenticates as a public client. The auth server is discovered automatically.
SWIGGY_MCP_FOOD_URL=https://mcp.swiggy.com/food
SWIGGY_MCP_INSTAMART_URL=https://mcp.swiggy.com/im
SWIGGY_MCP_DINEOUT_URL=https://mcp.swiggy.com/dineout

# OAuth redirect — must match the /auth/callback route and be reachable by the browser.
OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback

# Anthropic (optional — pre-canned responses used if not set)
ANTHROPIC_API_KEY=
# Chat model (optional — defaults to claude-sonnet-4-20250514 if not set)
ANTHROPIC_MODEL=

# OpenWeatherMap (optional — mock weather used if not set)
OPENWEATHER_API_KEY=

# Server
PORT=3001
NODE_ENV=development
